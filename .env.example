# AI Exam Portal Environment Configuration (for Docker / Local)

# MongoDB Connection (default points to Docker MongoDB container)
MONGO_URI=mongodb://mongodb:27017
DB_NAME=exam_portal

# OpenRouter / LLM Key (Required for AI Question Generation & Evaluation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# JWT Secret Key for Auth
JWT_SECRET=super_secret_jwt_key_exam_portal_2026
